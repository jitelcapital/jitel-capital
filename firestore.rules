rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil.rol == 'admin';
    }
    function esMiEmail(email) {
      return request.auth != null
        && request.auth.token.email != null
        && email == request.auth.token.email.lower();
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    match /pagos/{loanId}/pagos/{pagoId} {
      allow read, write: if isAdmin();
    }
    match /config/{docId} {
      allow read, write: if isAdmin();
    }
    match /socios/{code} {
      allow read, write: if isAdmin();
      allow read: if esMiEmail(resource.data.email);
    }
    match /prestamos/{loanId} {
      allow read: if isAdmin() || esMiEmail(resource.data.socio_email);
      allow write: if isAdmin();
    }
    match /giros/{giroId} {
      allow read: if isAdmin() || esMiEmail(resource.data.socio_email);
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /portal_clientes/{clienteId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
