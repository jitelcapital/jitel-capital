rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil.rol == 'admin';
    }
    function esMiEmail(email) {
      return request.auth != null
        && request.auth.token.email != null
        && email == request.auth.token.email.lower();
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    match /pagos/{loanId}/pagos/{pagoId} {
      allow read, write: if isAdmin();
    }
    // Versión actual de config/global (0 si el documento no existe o aún no tiene version).
    function versionActual() {
      return (resource == null || !('version' in resource.data)) ? 0 : resource.data.version;
    }
    match /config/{docId} {
      allow read: if isAdmin();
      // config/global solo se escribe subiendo la versión en exactamente 1: así una app con
      // datos viejos (o con código viejo, sin version) no puede reescribir lo que guardó otro.
      allow create, update: if isAdmin()
        && (docId != 'global' || request.resource.data.version == versionActual() + 1);
      allow delete: if isAdmin();
    }
    match /socios/{code} {
      allow read, write: if isAdmin();
      allow read: if esMiEmail(resource.data.email);
    }
    match /prestamos/{loanId} {
      allow read: if isAdmin() || esMiEmail(resource.data.socio_email);
      allow write: if isAdmin();
    }
    match /giros/{giroId} {
      allow read: if isAdmin() || esMiEmail(resource.data.socio_email);
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    // Comprobantes de giros (imagen JPEG en base64, ≤300 KB). Nunca se borran.
    match /comprobantes/{giroId} {
      allow read: if isAdmin() || esMiEmail(resource.data.socio_email);
      allow create, update: if isAdmin()
        && request.resource.data.imagen is string
        && request.resource.data.imagen.size() <= 307200;
      allow delete: if false;
    }
    // Índice de comprobantes (mismos datos, sin la imagen): qué giros tienen comprobante.
    match /comprobantes_idx/{giroId} {
      allow read: if isAdmin() || esMiEmail(resource.data.socio_email);
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    // Métricas de uso de la app (contadores por mes, uso/{YYYY-MM}). Solo admin.
    match /uso/{mes} {
      allow read, write: if isAdmin();
    }
    match /portal_clientes/{clienteId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
